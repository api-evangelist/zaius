{
  "opencollection": "1.0.0",
  "info": {
    "name": "Advanced Compliance Consent API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Consent",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update consent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.us1.odp.optimizely.com/v3/consent",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates marketing consent information for multiple customers."
        },
        {
          "info": {
            "name": "Get consent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us1.odp.optimizely.com/v3/consent/:identifier_field_name",
            "params": [
              {
                "name": "identifier_field_name",
                "value": "email",
                "type": "path",
                "description": "the name of the field that this identifier falls under, such as email"
              },
              {
                "name": "id",
                "value": "example@example.com",
                "type": "query",
                "description": "the valid messaging identifier you are requesting, such as an email address"
              }
            ]
          },
          "docs": "Get marketing consent information for a customer."
        }
      ]
    }
  ],
  "bundled": true
}