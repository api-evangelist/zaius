{
  "opencollection": "1.0.0",
  "info": {
    "name": "Advanced Compliance Object schema API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Object schema",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us1.odp.optimizely.com/v3/schema/objects"
          },
          "docs": "List the details of all objects within an Optimizely Data Platform (ODP) account."
        },
        {
          "info": {
            "name": "Create object",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.us1.odp.optimizely.com/v3/schema/objects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new Object within Optimizely Data Platform (ODP), define its fields and how it relates to other objects."
        },
        {
          "info": {
            "name": "Get object",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us1.odp.optimizely.com/v3/schema/objects/:object_name",
            "params": [
              {
                "name": "object_name",
                "value": "myobject",
                "type": "path",
                "description": "The name of the object."
              }
            ]
          },
          "docs": "List the details of a specific object in an Optimizely Data Platform (ODP) account."
        }
      ]
    }
  ],
  "bundled": true
}