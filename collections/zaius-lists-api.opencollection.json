{
  "opencollection": "1.0.0",
  "info": {
    "name": "Advanced Compliance Lists API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lists",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Subscription Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us1.odp.optimizely.com/v3/lists/subscriptions",
            "params": [
              {
                "name": "identifiers",
                "value": "",
                "type": "query",
                "description": "The identifier type, for example \"email\"."
              }
            ]
          },
          "docs": "Get the subscription status of a customer identifier to an Optimizely Data Platform (ODP) list."
        },
        {
          "info": {
            "name": "Subscribe/Unsubscribe",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.us1.odp.optimizely.com/v3/lists/subscriptions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Subscribe or unsubscribe a customer identifier to or from an Optimizely Data Platform (ODP) list."
        },
        {
          "info": {
            "name": "Get Lists",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us1.odp.optimizely.com/v3/lists"
          },
          "docs": "Get all lists associated with an Optimizely Data Platform (ODP) account."
        },
        {
          "info": {
            "name": "Create List",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.us1.odp.optimizely.com/v3/lists",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new list within an Optimizely Data Platform (ODP) account."
        }
      ]
    }
  ],
  "bundled": true
}