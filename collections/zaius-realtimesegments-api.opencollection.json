{
  "opencollection": "1.0.0",
  "info": {
    "name": "Advanced Compliance RealtimeSegments API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "RealtimeSegments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List segments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us1.odp.optimizely.com/v3/segments"
          },
          "docs": "Lists all the real-time segments for an account."
        },
        {
          "info": {
            "name": "Get segment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us1.odp.optimizely.com/v3/segments/:segment_id",
            "params": [
              {
                "name": "segment_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the schema of a requested segment. Note: this does not return the list of members in the segment."
        },
        {
          "info": {
            "name": "Create segment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.us1.odp.optimizely.com/v3/segments/:segment_id",
            "params": [
              {
                "name": "segment_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new segment."
        },
        {
          "info": {
            "name": "Update segment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.us1.odp.optimizely.com/v3/segments/:segment_id",
            "params": [
              {
                "name": "segment_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modify the parameters of an existing segment."
        },
        {
          "info": {
            "name": "Delete segment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.us1.odp.optimizely.com/v3/segments/:segment_id",
            "params": [
              {
                "name": "segment_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Removes the requested segment. Note: this does not delete the members of the segment."
        },
        {
          "info": {
            "name": "Validate segment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.us1.odp.optimizely.com/v3/segments/:segment_id:validate",
            "params": [
              {
                "name": "segment_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Validate segment definition."
        }
      ]
    }
  ],
  "bundled": true
}